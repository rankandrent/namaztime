# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare / OpenNext
.open-next
.wrangler
.dev.vars
cloudflare-env.d.ts

# Cloudflare / OpenNext build output (regenerated by the build)
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts

# Raw GeoNames snapshot — regenerable via scripts/download-geonames.ts;
# alternateNamesV2.zip alone is 193MB, over GitHub's 100MB file limit.
# data/processed/ (the compiled output the app actually reads) IS tracked.
data/raw/

# Generated by `npm run build` (scripts/build-city-shards.ts). Derived
# from data/processed/cities/, which IS committed. city-counts.json is
# deliberately NOT ignored — store.ts imports it statically, so tsc would
# fail on a fresh clone before the first build.
public/runtime-data/cities/

# Static sitemap output from scripts/generate_*sitemap*.py. The LIVE sitemap
# is the dynamic tier-filtered system (app/sitemap.ts + /sitemap_index.xml
# route, sourced from public/runtime-data/sitemap-paths.json). These static
# files conflicted with it at /sitemap_index.xml and only covered ~17% of
# URLs, so they are not shipped. Do not commit them.
public/sitemaps/
public/sitemap_index.xml
/output/
