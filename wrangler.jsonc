{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maghrib-time",
  "account_id": "fa9a409816328cfbafbf69db248cf243",
  "main": ".open-next/worker.js",
  // Bump this whenever revisiting deploy config — Workers behavior can be
  // gated by compatibility date, and OpenNext requires 2024-09-23+.
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    // Only the build-time pre-rendered pages + JS/CSS/images live here —
    // ISR pages rendered after build go to the KV incremental cache
    // instead (see open-next.config.ts). This keeps the file count well
    // under the 100,000-per-version Workers Paid limit.
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // OpenNext's own Worker calls back into itself (e.g. to trigger ISR
  // revalidation via a self-fetch) — this binding is how it does that
  // without a real network hop.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maghrib-time" }],
  // Keep the workers.dev URL alive. NOTE: adding a `routes` entry makes
  // wrangler disable workers.dev unless this is explicitly true — which
  // took the site offline once already when the custom domain was added.
  "workers_dev": true,
  // Attached once the deploy to this account is verified. Apex only,
  // deliberately: SITE_URL (lib/seo/site.ts) — and so every canonical
  // tag, hreflang entry and sitemap URL — is https://maghrib-time.com
  // with no www; serving www as a second custom domain would make the
  // same ~650k pages reachable at two hostnames. If www is wanted, add a
  // redirect rule to the apex, not a second origin.
  // A zone route, NOT `custom_domain: true`. custom_domain makes
  // Cloudflare create its own DNS record and it refuses when the hostname
  // already has one ("already has externally managed DNS records
  // [code: 100117]") — which this apex does. A route instead rides the
  // EXISTING proxied record and intercepts matching requests, so no DNS
  // has to be deleted. Requires the record to be proxied (orange cloud);
  // it is — the apex resolves to Cloudflare proxy IPs.
  // Apex only: SITE_URL (lib/seo/site.ts), and so every canonical tag,
  // hreflang entry and sitemap URL, is https://maghrib-time.com with no
  // www. If www is wanted, add a redirect rule to the apex rather than a
  // second origin serving the same ~650k pages.
  "routes": [{ "pattern": "maghrib-time.com/*", "zone_name": "maghrib-time.com" }],
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "6e84dfb455ad446dabede9dd0ef965d6" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "e342eb29850d4449bbbe6e2c0563162a" }
  ],
  "observability": {
    "enabled": true
  }
}
